rules_version = '2';
// Per-user access only: each user can read/write only their own data.
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: doc id must equal auth.uid.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Favorites subcollection: users/{uid}/favorites/{branchId}
      match /favorites/{branchId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
